rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /league/main {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == 'REPLACE_WITH_YOUR_GOOGLE_UID'
        && request.resource.data.keys().hasOnly(['players', 'matches', 'updatedAt'])
        && request.resource.data.players is list
        && request.resource.data.matches is map;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
